# =============================================================
# THE AURORA PROTOCOL — ENVIRONMENT VARIABLES
# =============================================================

# Server Port (Render & Railway inject PORT automatically)
PORT=3000

# Secret for signing JWT authentication tokens
JWT_SECRET=aurora_protocol_classified_sec_token_2026

# =============================================================
# MYSQL DATABASE (REQUIRED)
# =============================================================
# This application uses MySQL exclusively. You MUST configure
# one of the options below or the server will refuse to start.
#
# ── Option A: Single connection string (recommended) ─────────
# Free cloud MySQL providers:
#   • TiDB Cloud Serverless (5GB free forever) → https://tidbcloud.com/
#   • Aiven for MySQL (Free tier)              → https://aiven.io/
#   • Railway MySQL Plugin (+ New → Database → MySQL)
#
# MYSQL_URL=mysql://username:password@host:3306/aurora_db?ssl={"rejectUnauthorized":true}
#
# ── Option B: Individual variables ───────────────────────────
# (Railway injects these automatically when you add a MySQL plugin)
#
# MYSQLHOST=localhost
# MYSQLPORT=3306
# MYSQLUSER=root
# MYSQLPASSWORD=secret
# MYSQLDATABASE=aurora_db
