# =============================================================
# THE AURORA PROTOCOL — ENVIRONMENT VARIABLES
# =============================================================

# Server Port (Render & Railway inject PORT automatically)
PORT=3000

# Secret for signing JWT authentication tokens
JWT_SECRET=aurora_protocol_classified_sec_token_2026

# =============================================================
# OPTION 1: FREE CLOUD MYSQL (RECOMMENDED FOR FREE DEPLOYMENT)
# =============================================================
# You can get a 100% free forever MySQL database from:
# 1. TiDB Cloud Serverless (5GB free forever) -> https://tidbcloud.com/
# 2. Aiven for MySQL (Free tier) -> https://aiven.io/
# 3. Railway MySQL Plugin (Click '+ New' -> 'Database' -> 'MySQL')
#
# Use either a single connection string:
# MYSQL_URL=mysql://username:password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/aurora_db?ssl={"rejectUnauthorized":true}
#
# OR individual variables (Railway injects these automatically):
# MYSQLHOST=localhost
# MYSQLPORT=3306
# MYSQLUSER=root
# MYSQLPASSWORD=secret
# MYSQLDATABASE=aurora_db

# =============================================================
# OPTION 2: FREE CLOUD POSTGRESQL (ALTERNATIVE)
# =============================================================
# Free hosted Postgres from Supabase, Neon.tech, or Render
# DATABASE_URL=postgresql://user:password@host:5432/aurora_db?sslmode=require

# =============================================================
# OPTION 3: LOCAL SQLITE (DEFAULT FALLBACK)
# =============================================================
# If neither MYSQL_URL nor DATABASE_URL is set, the server automatically
# saves to data/aurora.sqlite on disk.
